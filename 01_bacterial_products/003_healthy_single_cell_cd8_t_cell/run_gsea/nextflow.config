resume = true
params.cpus = 16
params.resultDir = "/data/scratch/kvalem/projects/2021/honda_microbial_metabolites_2021/20_scripts/40_single-cell-sorted-cd8/40_gex_surface_prot/28012026/results/normal/cell_type/Naive"
params.sample_sheet = "/data/scratch/kvalem/projects/2021/honda_microbial_metabolites_2021/20_scripts/40_single-cell-sorted-cd8/40_gex_surface_prot/28012026/single_cell_normal/tables/cell_type/samplesheet_Naive_normal.csv"
params.raw_counts = "/data/scratch/kvalem/projects/2021/honda_microbial_metabolites_2021/20_scripts/40_single-cell-sorted-cd8/40_gex_surface_prot/28012026/single_cell_normal/tables/cell_type/counts_matrix_Naive_normal.tsv"
params.goi = "NO_FILE"
params.gtf = "/data/genomes/mm10/annotation/gencode/gencode.vM25.primary_assembly.annotation.gtf.gz"
params.organism = "mouse"
params.sample_col = "sample_id"
params.condition_col = "condition"
params.merge_duplicate_genes = true
params.paired_grp = ""
params.remove_batch_effect = false
params.batch_col =  ""
params.covariate_formula = ""
params.ext_opt = ""
params.cite_packages = ["DESeq2", "IHW", "clusterProfiler", "topGO", "ReactomePA", "EnhancedVolcano", "AnnotationDbi", "base"]
params.contrasts = [
                    ["TEST": "effector", "REF": "ctrl"],
                   ]

process {
    withName: de_analysis {
        memory = 32.GB
    }

    withName: generate_report {
        clusterOptions = '--gres=cputype:XG6342'
    }
}
